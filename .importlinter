[importlinter]
root_packages =
    mcp_tools_sql
    tests
root_package_paths =
    src
    .
include_external_packages = True

[importlinter:contract:layers]
name = Layered Architecture
type = layers
layers =
    mcp_tools_sql.main
    mcp_tools_sql.cli
    mcp_tools_sql.server
    mcp_tools_sql.toolset
    mcp_tools_sql.verification
    mcp_tools_sql.schema_tools | mcp_tools_sql.query_tools | mcp_tools_sql.update_tools | mcp_tools_sql.validation_tools | mcp_tools_sql.count_tools | mcp_tools_sql.summarize
    mcp_tools_sql.query_helpers
    mcp_tools_sql.tool_builder
    mcp_tools_sql.result_limits
    mcp_tools_sql.backends | mcp_tools_sql.formatting | mcp_tools_sql.tool_logging
    mcp_tools_sql.config | mcp_tools_sql.sql_ast
    mcp_tools_sql.utils


[importlinter:contract:forbidden-imports]
name = Forbidden external imports
type = forbidden
source_modules =
    mcp_tools_sql.utils
forbidden_modules =
    mcp_tools_sql.backends
    mcp_tools_sql.config
    mcp_tools_sql.formatting
    mcp_tools_sql.schema_tools
    mcp_tools_sql.query_tools
    mcp_tools_sql.query_helpers
    mcp_tools_sql.update_tools
    mcp_tools_sql.validation_tools
    mcp_tools_sql.count_tools
    mcp_tools_sql.summarize
    mcp_tools_sql.toolset
    mcp_tools_sql.server

# Only the MCP server imports the mcp SDK directly; toolkits, toolset,
# verification and utils stay importable without it (agent-workbench export
# path). The CLI still reaches mcp indirectly via server.
[importlinter:contract:no_mcp_on_export_path]
name = No mcp on the export path
type = forbidden
source_modules =
    mcp_tools_sql
forbidden_modules =
    mcp
ignore_imports =
    mcp_tools_sql.server -> mcp
allow_indirect_imports = True

[importlinter:contract:mcp_coder_utils_isolation]
name = MCP Coder Utils Isolation
type = forbidden
source_modules =
    mcp_tools_sql
forbidden_modules =
    mcp_coder_utils
ignore_imports =
    mcp_tools_sql.utils.** -> mcp_coder_utils

# Neither source nor tests import 'subprocess' directly; they go through the
# mcp_tools_sql.utils.subprocess_runner shim (over mcp-coder-utils).
[importlinter:contract:subprocess_isolation]
name = Subprocess Library Isolation
type = forbidden
source_modules =
    mcp_tools_sql
    tests
forbidden_modules =
    subprocess

# Only the SQL layer (mcp_tools_sql.sql_ast) imports sqlglot; callers get strings,
# opaque SourceRef/Predicate and SqlParseError. tests/sql_ast mirrors the owner and may
# assert sqlglot premises (TokenError vs ParseError, expected trees).
[importlinter:contract:sqlglot_isolation]
name = sqlglot Library Isolation
type = forbidden
source_modules =
    mcp_tools_sql
    tests
forbidden_modules =
    sqlglot
ignore_imports =
    mcp_tools_sql.sql_ast.** -> sqlglot
    tests.sql_ast.** -> sqlglot

# Only the backends import DB drivers; callers get DatabaseBackend, BackendError /
# BackendConnectionError and the dependency probes. pyodbc is imported lazily inside
# backends/mssql.py functions (optional extra).
[importlinter:contract:pyodbc_isolation]
name = pyodbc Library Isolation
type = forbidden
source_modules =
    mcp_tools_sql
    tests
forbidden_modules =
    pyodbc
ignore_imports =
    mcp_tools_sql.backends.** -> pyodbc

# Nothing imports psycopg until the PostgreSQL backend (#29) re-adds
# backends/postgresql.py together with an `mcp_tools_sql.backends.** -> psycopg` ignore.
[importlinter:contract:psycopg_isolation]
name = psycopg Library Isolation
type = forbidden
source_modules =
    mcp_tools_sql
    tests
forbidden_modules =
    psycopg

# sqlite3 additionally allowed in the owner's mirrored tests (tests/backends) and in the
# single shared fixture helper tests/sqlite_fixtures.py (user decision on #93).
[importlinter:contract:sqlite3_isolation]
name = sqlite3 Library Isolation
type = forbidden
source_modules =
    mcp_tools_sql
    tests
forbidden_modules =
    sqlite3
ignore_imports =
    mcp_tools_sql.backends.** -> sqlite3
    tests.backends.** -> sqlite3
    tests.sqlite_fixtures -> sqlite3

# Production code never imports from tests.
[importlinter:contract:no_test_imports_in_source]
name = Source Code Independence from Tests
type = forbidden
source_modules =
    mcp_tools_sql
forbidden_modules =
    tests
